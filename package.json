{
  "name": "personal-finance",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc -p tsconfig.build.json && vite build --config apps/web/vite.config.ts",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run tests/contracts.test.ts tests/currency-migration.test.ts tests/database-config.test.ts tests/demo-seed.test.ts tests/domain.test.ts tests/web.test.tsx",
    "test:ui-flows": "vitest run tests/ui-flows.test.tsx",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "test:docker": "tsx scripts/docker-smoke.ts",
    "proto:lint": "buf lint",
    "proto:generate": "buf generate && prettier --write packages/contracts/src",
    "proto:check": "tsx scripts/check-generated.ts",
    "proto:breaking": "buf breaking --against proto-baseline.binpb",
    "proto:baseline": "buf build -o proto-baseline.binpb",
    "api:generate": "tsx scripts/openapi.ts",
    "api:check": "tsx scripts/openapi.ts --check",
    "seed:demo": "node --import tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@bufbuild/protobuf": "2.15.0",
    "@bufbuild/protovalidate": "1.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.4",
    "@libsql/client": "0.18.0",
    "@tanstack/react-query": "5.103.1",
    "antd": "6.6.5",
    "better-sqlite3": "12.4.1",
    "csv-parse": "7.0.2",
    "dayjs": "1.11.23",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.5",
    "i18next": "25.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.88.0",
    "react-i18next": "16.2.4",
    "react-router": "7.18.2",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.57.2",
    "@bufbuild/protoc-gen-es": "2.9.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.36.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "jsdom": "30.1.0",
    "msw": "2.11.2",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.3.5",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
