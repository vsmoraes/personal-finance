PORT=8080
HOST=127.0.0.1
DATABASE_URL=file:./data/finance.db
# Container UID/GID must own ./data. Default node image account is 1000:1000.
FINANCE_UID=1000
FINANCE_GID=1000
# Copy to .env (ignored by git) and fill in your Google web client ID.
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
APP_ORIGIN=http://localhost:8080
